# Copy this file to .env (cp .env.example .env) and edit as needed.
# .env itself is gitignored -- this file is the only thing that ships.

# --- Full experience (default): real LLM agents with persistent memory -----
# Requires Ollama running locally, and Palimpsest installed as a local
# editable dependency (see README's "Full experience" section).
COGNITION_MODE=llm
MEMORY_ENABLED=true

# --- Fastest path: no Ollama, no Palimpsest, no extra setup ---------------
# Rule-based mock brain, memory off. Handy for fast iteration on game balance.
# Either flip these, or just run: python run.py --mock
#   COGNITION_MODE=mock
#   MEMORY_ENABLED=false

# Per-agent model + temperature are set in app/core/world_seed.py, not here.
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# How often the colony advances a tick, in seconds. LLM mode is much slower
# per tick than mock mode -- raise this if it feels sluggish on your hardware.
TICK_INTERVAL_SECONDS=20

# Optional, only relevant with MEMORY_ENABLED=true -- judge crew-trust and threat observations with a pretrained NLI
# model (CPU only) instead of token overlap, so defying an order contradicts complying with it. "off" or "nli".
# Needs: pip install -e "../../Palimpsest[nli]". Falls back to the token-overlap rules if that is missing.
# MEMORY_JUDGE=nli
# MEMORY_JUDGE_THREADS=4

# Optional, only relevant with MEMORY_ENABLED=true -- how long (in seconds)
# an unreinforced belief takes to decay halfway toward uncertainty. Defaults
# to 6 hours in code if unset.
# MEMORY_DECAY_HALF_LIFE_SECONDS=21600
